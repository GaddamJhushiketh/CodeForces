import java.util.Scanner;
public class Lucky{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int t = sc.nextInt();
        while(t-->0){
            String s = sc.next();
            int left = 0;
            int right = 0;
            for(int i=0;i<3;i++){
                left += s.charAt(i) - '0';
            }
            for(int i=3;i<6;i++){
                right += s.charAt(i) - '0';
            }
            if(left == right){
                System.out.println("YES");
            }
            else{
                System.out.println("NO");
            }
        }
    }
}