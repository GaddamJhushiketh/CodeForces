import java.util.*;
public class DaytonaCost{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int t = sc.nextInt();
        while(t-->0){
            int n = sc.nextInt();
            int k = sc.nextInt();
            int arr[] = new int[n];
            for(int i =0;i<n;i++){
                arr[i] = sc.nextInt();
            }
            boolean f = false;
            for(int i =0;i<n;i++){
                if(arr[i] == k){
                    f = true;
                }
            }
            if(f){
                System.out.println("YES");
            }
            else{
                System.out.println("NO");
            }
 
        }
    }
}