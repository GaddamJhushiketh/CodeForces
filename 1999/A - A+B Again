import java.util.*;
public class ABAgain{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int t = sc.nextInt();
        while(t-->0){
            int n = sc.nextInt();
            int sum =0;
            while(n>0){
                int dig = n%10;
                n = n/10;
                sum+=dig;
            }
            System.out.println(sum);
        }
    }
}